    FileHeader_Characteristics      0x02

    OptionalHeader_Magic                    0x02
    OptionalHeader_MajorLinkerVersion       0x01
    OptionalHeader_MinorLinkerVersion       0x01
    OptionalHeader_SizeOfCode               0x04
    OptionalHeader_SizeOfInitializedData    0x04
    OptionalHeader_SizeOfUninitializedData  0x04
    OptionalHeader_AddressOfEntryPoint      0x04
    OptionalHeader_BaseOfCode               0x04
    OptionalHeader_ImageBase                0x08
    OptionalHeader_SectionAlignment         0x04
    OptionalHeader_FileAlignment            0x04
    OptionalHeader_MajorOSVersion           0x02
    OptionalHeader_MinorOSVersion           0x02
    OptionalHeader_MajorImageVersion        0x02
    OptionalHeader_MinorImageVersion        0x02
    OptionalHeader_MajorSubsystemVersion    0x02
    OptionalHeader_MinorSubsystemVersion    0x02
    OptionalHeader_Win32VersionValue        0x04
    OptionalHeader_SizeOfImage              0x04
    OptionalHeader_SizeOfHeaders            0x04
    OptionalHeader_CheckSum                 0x04
    OptionalHeader_Subsystem                0x02
    OptionalHeader_DllCharacteristics       0x02
    OptionalHeader_SizeOfStackReserve       0x08
    OptionalHeader_SizeOfStackCommit        0x08
    OptionalHeader_SizeOfHeapReserve        0x08
    OptionalHeader_SizeOfHeapCommit         0x08
    OptionalHeader_LoaderFlags              0x04
    OptionalHeader_NumberOfRvaAndSizes      0x04

    DataDirectory_ExportTable               0x08
    DataDirectory_ImportTable               0x08
    DataDirectory_ResourceTable             0x08
    DataDirectory_ExceptionTable            0x08
    DataDirectory_CertificateTable          0x08
    DataDirectory_RelocationTable           0x08
