struct MYPEB {
    Reserved1 0x01
    BeingDebugged 0x01
    BitField 0x01
    CrossProcessFlags 0x01
    Reserved3 0x12
    Reserved3_1 0x08
    Ldr 0x08
    ProcessParameters 0x08
};

struct PE {
    e_magic                 0x02
    e_cblp                  0x02
    e_cp                    0x02
    e_crlc                  0x02
    e_cparhdr               0x02
    e_minalloc              0x02
