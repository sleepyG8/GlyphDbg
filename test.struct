    e_res                   0x08
    e_oemid                 0x02
    e_oeminfo               0x02
    e_res2                  0x20
    e_lfanew                0x04

    PE_Signature            0x04

    FileHeader_Machine              0x02
    FileHeader_NumberOfSections     0x02
    FileHeader_TimeDateStamp        0x04
    FileHeader_PointerToSymbolTable 0x04
    FileHeader_NumberOfSymbols      0x04
